{
  "$id": "https://github.com/scientific7/medical-imaging-platform-contracts/blob/main/schemas/v1/dataset_release.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dataset_id": {
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "manifest_sha256": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Manifest Sha256",
      "type": "object"
    },
    "receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Sha256",
      "type": "string"
    },
    "receipt_uri": {
      "minLength": 1,
      "title": "Receipt Uri",
      "type": "string"
    },
    "release_id": {
      "minLength": 1,
      "title": "Release Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "const": "published",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "release_id",
    "receipt_uri",
    "receipt_sha256",
    "manifest_sha256",
    "status"
  ],
  "title": "DatasetReleaseReference",
  "type": "object"
}
