{
  "$id": "https://github.com/scientific7/medical-imaging-platform-contracts/blob/main/schemas/v1/inference_request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_type": {
      "default": "image/jpeg",
      "enum": [
        "image/jpeg",
        "image/png",
        "image/tiff",
        "image/webp"
      ],
      "title": "Content Type",
      "type": "string"
    },
    "image_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Image Sha256",
      "type": "string"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "model_id",
    "image_sha256"
  ],
  "title": "InferenceRequest",
  "type": "object"
}
